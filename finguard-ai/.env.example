# ---------------------------------------------------------------------------
# FinGuard AI environment configuration. Copy to `.env` and adjust.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=finguard
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=finguard

# --- Backend ---
# Local dev without Postgres uses SQLite by default if this is unset.
DATABASE_URL=postgresql+psycopg2://finguard:change-me-in-production@localhost:5432/finguard
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=10
MAX_BATCH_ROWS=50000

# --- Frontend ---
# Leave empty to use the dev proxy; set to the backend URL in production.
VITE_API_BASE_URL=
